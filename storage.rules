rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public read
      allow read: if true;
      // Allow write if authenticated and admin
      allow write: if request.auth != null && 
        firestore.get(/databases/(default)/documents/user_profiles/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
